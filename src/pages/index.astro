---
import BaseLayout from '../layouts/BaseLayout.astro';
import { whoMedia } from '../data/who-media';
---

<BaseLayout title="Public Praxis Lab" description="Public Praxis Lab website. Approved organisation and service content is being prepared for publication.">
  <section class="home-section home-hero" aria-labelledby="hero-heading">
    <div class="home-width hero-layout">
      <div class="hero-panel content-block">
        <p class="section-marker">Public Praxis Lab</p>
        <h1 id="hero-heading"><span>Better Decisions.</span><span>Better Systems.</span><span>Better Futures.</span></h1>
        <div class="hero-intro">
          <p class="hero-placeholder-label">Introductory text placeholder</p>
          <p>Final introductory copy has not yet been supplied.</p>
        </div>
        <div class="hero-services">
          <p class="hero-services-label">Service routes <span>· links pending</span></p>
          <div class="hero-service-options">
            <span>Corporate Services</span>
            <span>Non-Corporate Services</span>
          </div>
        </div>
      </div>
      <div class="hero-media" role="img" aria-label="Hero editorial photograph placeholder; no photograph has been supplied">
        <span>Editorial photograph placeholder</span>
      </div>
    </div>
  </section>

  <section class="home-section home-section--dark about-section" aria-labelledby="about-heading">
    <div class="home-width about-layout">
      <div class="about-copy content-block">
        <p class="section-marker">About Public Praxis Lab</p>
        <h2 id="about-heading">About Us</h2>
        <div class="about-intro">
          <p class="placeholder-kicker">Introduction copy placeholder</p>
          <p>Approved copy about Public Praxis Lab has not yet been supplied.</p>
        </div>
        <p class="about-action">Find out more <span>· link pending</span></p>
      </div>
      <div class="about-media" role="group" aria-label="About editorial photographs pending">
        <div class="about-media-back" aria-hidden="true"></div>
        <div class="about-media-primary" role="img" aria-label="Primary About photograph placeholder; no photograph supplied">
          <span>Primary photograph placeholder</span>
        </div>
        <div class="about-media-secondary" role="img" aria-label="Secondary About photograph placeholder; no photograph supplied">
          <span>Secondary photograph placeholder</span>
        </div>
      </div>
    </div>
  </section>

  <section class="home-section approach-section" aria-labelledby="approach-heading">
    <div class="home-width">
      <p class="section-marker">How we work</p>
      <h2 id="approach-heading">Our Approach</h2>
      <div class="approach-layout">
        <div class="approach-card">
          <p class="placeholder-kicker">Principle wording from design reference · pending approval</p>
          <ol class="approach-principles">
            <li><strong>Systems do not change through critique alone.</strong><span>Supporting copy placeholder.</span></li>
            <li><strong>Good decisions start with a focus on people.</strong><span>Supporting copy placeholder.</span></li>
          </ol>
          <p class="approach-action">Read more <span>· link pending</span></p>
        </div>
        <div class="approach-media" role="img" aria-label="Our Approach editorial photograph placeholder; no photograph supplied">
          <span>Editorial photograph placeholder</span>
        </div>
      </div>
    </div>
  </section>

  <section class="home-section home-section--dark hybrid-section" aria-labelledby="hybrid-heading">
    <div class="home-width">
      <p class="section-marker">Three areas · one model</p>
      <h2 id="hybrid-heading">Hybrid Model</h2>
      <p class="hybrid-intro">Think Tank, Consultancy and Strategy Lab form the three connected areas of our hybrid model.</p>
      <ul class="hybrid-model" role="list">
        <li>
          <span class="hybrid-connection" aria-hidden="true"><span></span></span>
          <div class="hybrid-area">
            <h3>Think Tank</h3>
            <p class="placeholder-kicker">Description pending</p>
            <p>Approved Think Tank copy has not yet been supplied.</p>
          </div>
        </li>
        <li>
          <span class="hybrid-connection" aria-hidden="true"><span></span></span>
          <div class="hybrid-area">
            <h3>Consultancy</h3>
            <p class="placeholder-kicker">Description pending</p>
            <p>Approved Consultancy copy has not yet been supplied.</p>
          </div>
        </li>
        <li>
          <span class="hybrid-connection" aria-hidden="true"><span></span></span>
          <div class="hybrid-area">
            <h3>Strategy Lab</h3>
            <p class="placeholder-kicker">Description pending</p>
            <p>Approved Strategy Lab copy has not yet been supplied.</p>
          </div>
        </li>
      </ul>
      <p class="hybrid-copy-note"><strong>Relationship copy pending.</strong> Approved detail on how the three areas work together has not yet been supplied.</p>
    </div>
  </section>

  <section class="home-section capability-section" aria-labelledby="capability-heading">
    <div class="home-width">
      <header class="capability-intro">
        <p class="section-marker">Think Tank / Consultancy / Strategy Lab</p>
        <h2 id="capability-heading">Our capabilities</h2>
        <p class="placeholder-kicker">Section introduction pending approved copy.</p>
      </header>
      <div class="capability-composition">
        <section class="capability-area capability-area--think" aria-labelledby="think-tank-heading">
          <div class="capability-card">
            <h3 id="think-tank-heading">Think Tank</h3>
            <p class="placeholder-kicker">Editorial copy pending</p>
            <p>Approved Think Tank description and supporting detail have not yet been supplied.</p>
          </div>
          <div class="capability-media" role="img" aria-label="Think Tank editorial photograph placeholder; no photograph supplied">
            <span>Think Tank photograph placeholder</span>
          </div>
        </section>
        <section class="capability-area capability-area--consultancy" aria-labelledby="consultancy-heading">
          <div class="capability-card">
            <h3 id="consultancy-heading">Consultancy</h3>
            <p class="placeholder-kicker">Editorial copy pending</p>
            <p>Approved Consultancy description and supporting detail have not yet been supplied.</p>
          </div>
          <div class="capability-media" role="img" aria-label="Consultancy editorial photograph placeholder; no photograph supplied">
            <span>Consultancy photograph placeholder</span>
          </div>
        </section>
        <section class="capability-area capability-area--strategy" aria-labelledby="strategy-lab-heading">
          <div class="capability-card">
            <h3 id="strategy-lab-heading">Strategy Lab</h3>
            <p class="placeholder-kicker">Editorial copy pending</p>
            <p>Approved Strategy Lab description and supporting detail have not yet been supplied.</p>
          </div>
          <div class="capability-media-frame">
            <div class="capability-media" role="img" aria-label="Strategy Lab editorial photograph placeholder; no photograph supplied">
              <span>Strategy Lab photograph placeholder</span>
            </div>
          </div>
        </section>
      </div>
    </div>
  </section>

  <section class="home-section home-section--dark home-section--deep" aria-labelledby="who-heading">
    <div class="home-width who-layout">
      <div class="who-copy content-block">
        <p class="section-marker">Who We Are</p>
        <h2 id="who-heading">Who We Are</h2>
        <div class="who-intro">
          <p class="placeholder-kicker">People and organisation copy placeholder</p>
          <p>Approved information about the people and organisation has not yet been supplied.</p>
        </div>
        <p class="who-media-note">Media is pending. Any future video will provide captions and a transcript where speech is present; it will not autoplay with sound.</p>
      </div>
      <div class="who-media">
        <figure class="who-media-figure">
          {whoMedia.poster ? (
            <img
              class="who-media-poster"
              src={whoMedia.poster.src}
              alt={whoMedia.poster.alt}
              width={whoMedia.poster.width}
              height={whoMedia.poster.height}
              loading="lazy"
              decoding="async"
            />
          ) : (
            <div class="who-media-placeholder" role="img" aria-label="Who We Are media placeholder; no video, poster image, or photograph has been supplied">
              <span>Video, poster image or photograph placeholder</span>
            </div>
          )}
          <figcaption class="who-media-caption">
            <p class="placeholder-kicker">Caption placeholder</p>
            <p>Final media caption has not yet been supplied.</p>
          </figcaption>
        </figure>
        <section class="who-transcript" aria-labelledby="who-transcript-heading">
          <h3 id="who-transcript-heading">Transcript</h3>
          <p class="placeholder-kicker">Transcript placeholder</p>
          <p>A transcript will be provided if the final media includes speech.</p>
        </section>
      </div>
    </div>
  </section>

  <section class="home-section home-section--dark" aria-labelledby="stories-heading">
    <div class="home-width stories-section">
      <header class="stories-intro">
        <p class="section-marker">Testimonials / Case Studies · content placeholder</p>
        <h2 id="stories-heading">Testimonials and Case Studies</h2>
        <p>Approved quotes, client attributions and case-study content are pending.</p>
      </header>
      <div class="stories-layout">
        <section class="testimonials" aria-labelledby="testimonials-heading">
          <h3 id="testimonials-heading">Testimonials</h3>
          <p class="placeholder-kicker">Quotes and attributions pending</p>
          <div class="testimonials-grid">
            <article class="testimonial-card">
              <p class="card-placeholder-label">Testimonial placeholder</p>
              <p>No approved quotation or attribution has been supplied.</p>
            </article>
            <article class="testimonial-card">
              <p class="card-placeholder-label">Testimonial placeholder</p>
              <p>No approved quotation or attribution has been supplied.</p>
            </article>
            <article class="testimonial-card">
              <p class="card-placeholder-label">Testimonial placeholder</p>
              <p>No approved quotation or attribution has been supplied.</p>
            </article>
          </div>
        </section>
        <section class="case-study-preview" aria-labelledby="case-studies-heading">
          <div class="case-study-copy">
            <h3 id="case-studies-heading">Case Studies</h3>
            <p class="placeholder-kicker">Case-study preview pending</p>
            <p>No client, challenge, approach, outcome or supporting media has been supplied.</p>
            <p class="case-studies-action">Explore our case studies <span>· link pending</span></p>
          </div>
          <div class="case-study-media" role="img" aria-label="Case study editorial image placeholder; no image has been supplied">
            <span>Case study editorial image placeholder</span>
          </div>
        </section>
      </div>
    </div>
  </section>

  <section class="home-section home-cta" aria-labelledby="cta-heading">
    <div class="home-width cta-layout">
      <div class="cta-copy">
        <p class="section-marker">Final call to action · content pending</p>
        <h2 id="cta-heading">Closing invitation placeholder</h2>
        <p>Final call-to-action copy has not yet been supplied.</p>
      </div>
      <p class="cta-action">Contact route <span>· link pending</span></p>
    </div>
  </section>
</BaseLayout>

<style>
  .home-width { width: min(100% - 2rem, 70rem); margin-inline: auto; }
  .home-section { padding-block: clamp(3rem, 7vw, 6rem); }
  .home-section--dark { background: var(--color-navy); color: var(--color-paper); }
  .home-section--deep { background: var(--color-navy-deep); }
  .home-section--soft { background: var(--color-soft); }
  .content-block { display: grid; align-content: center; justify-items: start; gap: var(--space-6); min-width: 0; }
  .content-block > p:not(.section-marker):not(.action-placeholder) { max-width: var(--container-reading); }
  .section-marker { font-size: var(--text-sm); font-weight: 800; letter-spacing: .06em; text-transform: uppercase; }
  .section-intro { max-width: var(--container-reading); }
  .hero-layout { display: grid; gap: var(--space-8); align-items: center; }
  .home-hero { background: var(--color-soft); }
  .hero-layout { align-items: stretch; }
  .hero-panel { gap: 0; padding: clamp(var(--space-6), 4vw, var(--space-12)); background: var(--color-navy-deep); color: var(--color-paper); border-radius: var(--radius-card); }
  .hero-panel .section-marker { margin-block-end: var(--space-8); color: #d7e3e9; }
  .hero-panel h1 { font-size: clamp(1.75rem, 5vw, 3.5rem); line-height: 1.08; }
  .hero-panel h1 span { display: block; }
  .hero-intro { margin-block-start: clamp(var(--space-8), 4vw, var(--space-12)); max-width: 34rem; }
  .hero-placeholder-label, .hero-services-label { font-size: var(--text-sm); font-weight: 800; }
  .hero-placeholder-label { color: #d7e3e9; }
  .hero-intro p + p { margin-block-start: var(--space-2); }
  .hero-services { width: 100%; margin-block-start: var(--space-8); }
  .hero-services-label span { font-weight: 500; }
  .hero-service-options { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-block-start: var(--space-4); }
  .hero-service-options span { display: inline-flex; align-items: center; justify-content: center; min-height: 3rem; padding: var(--space-3) var(--space-6); border-radius: var(--radius-pill); background: var(--color-paper); color: var(--color-navy-deep); font-size: var(--text-sm); font-weight: 800; line-height: 1.25; text-align: center; }
  .hero-media { display: grid; align-items: end; min-width: 0; min-height: 22rem; padding: var(--space-6); border: 2px dashed var(--color-slate); border-radius: var(--radius-card); background: #dbe4e8; color: var(--color-ink); }
  .hero-media span { justify-self: start; padding: var(--space-3) var(--space-4); border-radius: var(--radius-sm); background: var(--color-paper); font-size: var(--text-sm); font-weight: 800; }
  .action-placeholder { padding: var(--space-3) var(--space-4); border: 1px dashed currentColor; border-radius: var(--radius-sm); font-size: var(--text-sm); font-weight: 700; }
  .media-placeholder { display: grid; place-items: center; min-width: 0; min-height: 14rem; padding: var(--space-6); border: 2px dashed currentColor; border-radius: var(--radius-card); background: #dbe4e8; color: var(--color-ink); font-size: var(--text-sm); font-weight: 700; text-align: center; }
  .about-layout { display: grid; gap: clamp(var(--space-8), 5vw, var(--space-16)); align-items: center; }
  .about-copy { gap: var(--space-6); }
  .about-copy h2 { font-size: clamp(2.75rem, 5vw, 4.5rem); }
  .about-intro { max-width: 33rem; }
  .placeholder-kicker { font-size: var(--text-sm); font-weight: 800; }
  .about-intro p + p { margin-block-start: var(--space-3); }
  .about-action, .approach-action { display: inline-flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: var(--space-2); min-height: 3rem; padding: var(--space-3) var(--space-6); border-radius: var(--radius-pill); background: var(--color-paper); color: var(--color-navy-deep); font-size: var(--text-sm); font-weight: 800; line-height: 1.25; text-align: center; }
  .about-action span, .approach-action span { font-weight: 500; }
  .about-media { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); grid-template-rows: repeat(10, minmax(0, 1fr)); width: 100%; min-width: 0; aspect-ratio: 1.15; }
  .about-media-back { grid-column: 4 / 12; grid-row: 1 / 11; border-radius: var(--radius-card); background: var(--color-paper); }
  .about-media-primary, .about-media-secondary { display: grid; align-items: end; min-width: 0; padding: var(--space-4); border: 2px dashed var(--color-slate); border-radius: var(--radius-card); color: var(--color-ink); }
  .about-media-primary { grid-column: 2 / 10; grid-row: 2 / 9; align-items: start; background: #dbe4e8; }
  .about-media-secondary { grid-column: 6 / 13; grid-row: 5 / 10; background: #b9cbd3; }
  .about-media span, .approach-media span { justify-self: start; padding: var(--space-2) var(--space-3); border-radius: var(--radius-sm); background: var(--color-paper); font-size: var(--text-sm); font-weight: 800; line-height: 1.3; }
  .approach-section { background: var(--color-paper); }
  .approach-section h2 { margin-block: var(--space-3) var(--space-8); }
  .approach-layout { display: grid; gap: var(--space-6); align-items: stretch; }
  .approach-card { display: grid; align-content: center; justify-items: start; gap: var(--space-6); min-width: 0; padding: clamp(var(--space-6), 4vw, var(--space-12)); border-radius: var(--radius-card); background: var(--color-navy-deep); color: var(--color-paper); }
  .approach-principles { display: grid; gap: var(--space-6); margin: 0; padding-inline-start: 1.5em; }
  .approach-principles li { padding-inline-start: var(--space-2); }
  .approach-principles strong, .approach-principles span { display: block; }
  .approach-principles strong { font-size: var(--text-lg); line-height: 1.35; }
  .approach-principles span { margin-block-start: var(--space-2); }
  .approach-media { display: grid; align-items: end; min-width: 0; min-height: 20rem; padding: var(--space-6); border: 2px dashed var(--color-slate); border-radius: var(--radius-card); background: #dbe4e8; color: var(--color-ink); }
  .hybrid-section h2 { margin-block: var(--space-3) var(--space-6); }
  .hybrid-intro { max-width: 42rem; font-size: var(--text-lg); }
  .hybrid-model { display: grid; margin-block: var(--space-8) var(--space-6); padding: clamp(var(--space-6), 4vw, var(--space-12)); list-style: none; border-radius: var(--radius-card); background: var(--color-soft); color: var(--color-ink); }
  .hybrid-model > li { display: grid; grid-template-columns: 1rem minmax(0, 1fr); column-gap: var(--space-4); min-width: 0; }
  .hybrid-connection { display: flex; flex-direction: column; align-items: center; padding-block-start: .4rem; }
  .hybrid-connection > span { flex: 0 0 1rem; width: 1rem; height: 1rem; border: 3px solid var(--color-navy); border-radius: 50%; background: var(--color-soft); }
  .hybrid-connection::after { content: ''; flex: 1; width: 2px; background: var(--color-slate); }
  .hybrid-model > li:last-child .hybrid-connection::after { visibility: hidden; }
  .hybrid-area { padding-block-end: var(--space-8); }
  .hybrid-model > li:last-child .hybrid-area { padding-block-end: 0; }
  .hybrid-area h3 { font-size: clamp(1.5rem, 2.5vw, 2rem); overflow-wrap: anywhere; }
  .hybrid-area .placeholder-kicker { margin-block-start: var(--space-6); color: var(--color-slate); }
  .hybrid-area p + p { margin-block-start: var(--space-2); }
  .hybrid-copy-note { max-width: var(--container-reading); font-size: var(--text-sm); }
  @media (min-width: 64rem) {
    .hybrid-model { grid-template-columns: repeat(3, minmax(0, 1fr)); padding-inline: var(--space-6); }
    .hybrid-model > li { display: block; }
    .hybrid-connection { flex-direction: row; padding: 0; }
    .hybrid-connection::before, .hybrid-connection::after { content: ''; flex: 1; height: 2px; background: var(--color-slate); }
    .hybrid-model > li:first-child .hybrid-connection::before { visibility: hidden; }
    .hybrid-area, .hybrid-model > li:last-child .hybrid-area { padding: var(--space-8) var(--space-6) 0; }
  }
  .capability-section { background: var(--color-paper); }
  .capability-intro { display: grid; gap: var(--space-4); margin-block-end: clamp(var(--space-8), 5vw, var(--space-16)); }
  .capability-intro > p { max-width: var(--container-reading); }
  .capability-intro .placeholder-kicker { color: var(--color-slate); }
  .capability-composition { display: grid; gap: clamp(var(--space-12), 6vw, var(--space-24)); }
  .capability-area { display: grid; gap: var(--space-6); min-width: 0; }
  .capability-card { min-width: 0; padding: clamp(var(--space-6), 4vw, var(--space-12)); border: 1px solid var(--color-navy); border-radius: var(--radius-card); background: var(--color-navy); color: var(--color-paper); }
  .capability-card h3 { font-size: clamp(2rem, 4vw, 3.25rem); overflow-wrap: anywhere; }
  .capability-card .placeholder-kicker { margin-block-start: var(--space-8); }
  .capability-card p + p { margin-block-start: var(--space-3); }
  .capability-area--consultancy .capability-card { background: var(--color-paper); color: var(--color-ink); border-color: var(--color-slate); }
  .capability-media { display: grid; align-items: start; min-width: 0; min-height: 16rem; padding: var(--space-6); border: 2px dashed var(--color-slate); border-radius: var(--radius-card); background: #dbe4e8; color: var(--color-ink); }
  .capability-media span { justify-self: start; max-width: 100%; padding: var(--space-2) var(--space-3); border-radius: var(--radius-sm); background: var(--color-paper); font-size: var(--text-sm); font-weight: 800; line-height: 1.4; }
  .capability-area--consultancy .capability-media { background: #b9cbd3; }
  .capability-media-frame { min-width: 0; }
  @media (min-width: 64rem) {
    .capability-area { grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 0; align-items: start; }
    .capability-card { grid-column: 1 / 8; grid-row: 1; margin-block-start: var(--space-8); min-height: 21rem; }
    .capability-media, .capability-media-frame { grid-column: 9 / 13; grid-row: 1; }
    .capability-area--think .capability-media { min-height: 17rem; }
    .capability-area--consultancy .capability-card { grid-column: 3 / 10; margin-block-start: var(--space-24); z-index: 1; }
    .capability-area--consultancy .capability-media { grid-column: 8 / 12; min-height: 23rem; }
    .capability-media-frame { display: grid; grid-template-columns: var(--space-6) minmax(0, 1fr) var(--space-6); grid-template-rows: var(--space-6) auto var(--space-6); }
    .capability-media-frame::before { content: ''; grid-column: 2 / 4; grid-row: 2 / 4; border-radius: var(--radius-card); background: var(--color-navy); }
    .capability-media-frame .capability-media { grid-column: 1 / 3; grid-row: 1 / 3; min-height: 20rem; z-index: 1; }
  }
  .who-layout { display: grid; gap: var(--space-8); }
  .who-copy { gap: var(--space-6); }
  .who-intro { max-width: var(--container-reading); }
  .who-intro p + p { margin-block-start: var(--space-3); }
  .who-media-note { max-width: 40rem; font-size: var(--text-sm); }
  .who-media { display: grid; gap: var(--space-4); min-width: 0; margin: 0; }
  .who-media-figure { display: grid; gap: var(--space-4); min-width: 0; margin: 0; }
  .who-media-poster { width: 100%; height: auto; border-radius: var(--radius-card); }
  .who-media-placeholder { display: grid; place-items: center; min-width: 0; min-height: 18rem; padding: var(--space-6); border: 2px dashed #91aab6; border-radius: var(--radius-card); background: #bdced6; color: var(--color-ink); text-align: center; }
  .who-media-placeholder span { max-width: 100%; padding: var(--space-3) var(--space-4); border-radius: var(--radius-sm); background: var(--color-paper); font-size: var(--text-sm); font-weight: 800; line-height: 1.4; }
  .who-media-caption, .who-transcript { padding: var(--space-4); border-inline-start: 2px solid #91aab6; background: rgb(255 255 255 / 0.06); }
  .who-media-caption p + p, .who-transcript p + p { margin-block-start: var(--space-2); }
  .who-transcript h3 { font-size: var(--text-lg); letter-spacing: normal; }
  .who-transcript .placeholder-kicker { margin-block-start: var(--space-3); }
  .stories-section { display: grid; gap: clamp(var(--space-8), 5vw, var(--space-16)); }
  .stories-intro { display: grid; gap: var(--space-4); max-width: var(--container-reading); }
  .stories-layout { display: grid; gap: var(--space-8); min-width: 0; }
  .testimonials, .case-study-preview { min-width: 0; }
  .testimonials > .placeholder-kicker, .case-study-copy > .placeholder-kicker { margin-block-start: var(--space-3); color: #d7e3e9; }
  .testimonials-grid { display: grid; gap: var(--space-4); margin-block-start: var(--space-6); }
